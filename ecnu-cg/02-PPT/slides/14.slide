<Slide style={{ width: '1280px', height: '720px', backgroundColor: '#FFFFFF', padding: '0px', flexDirection: 'column' }}>
    <Box style={{ width: '1280px', height: '8px', backgroundColor: '#1E4FA8' }} />
    <Box style={{ padding: '14px 40px 0px 40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 33, fontWeight: 'bold', color: '#1E4FA8' }}>重建过程：同一机位，12 个瞬间</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8' }}>14 / 16</Text>
    </Box>
    <Box style={{ padding: '6px 40px 0px 40px' }}>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.35 }}>85 张照片全程 <b>54 秒</b>；12 格的<b>相机位姿与内参完全固定</b>，唯一的变量是“模型当时建到哪儿”。</Text>
    </Box>

    <Box style={{ padding: '8px 40px 0px 40px', flexDirection: 'column', gap: 6 }}>
        <Box style={{ flexDirection: 'row', gap: 8, justifyContent: 'center' }}>
            <Box style={{ flexDirection: 'column', alignItems: 'center' }}>
                <Image src="prog_fix/tiles/t01.jpg" style={{ width: 164, height: 219 }} />
                <Text style={{ fontSize: 12.5, color: '#4A5568', marginTop: 4 }}>#36 ｜ 8 关键帧</Text>
            </Box>
            <Box style={{ flexDirection: 'column', alignItems: 'center' }}>
                <Image src="prog_fix/tiles/t02.jpg" style={{ width: 164, height: 219 }} />
                <Text style={{ fontSize: 12.5, color: '#4A5568', marginTop: 4 }}>#40 ｜ 9 关键帧</Text>
            </Box>
