<Slide style={{ width: '1280px', height: '720px', backgroundColor: '#FFFFFF', padding: '0px', flexDirection: 'column' }}>
    <Box style={{ width: '1280px', height: '8px', backgroundColor: '#1E4FA8' }} />
    <Box style={{ padding: '26px 40px 0px 40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 33, fontWeight: 'bold', color: '#1E4FA8' }}>落位：先把深度对齐，再按屏幕尺寸压成层级</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8' }}>11 / 15</Text>
    </Box>
    <Box style={{ padding: '8px 40px 0px 40px' }}>
        <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.4 }}>位姿定下来之后才投放高斯：分块估深度尺度与偏移，再把屏幕上看不见的小高斯合并掉。</Text>
    </Box>
    <Box style={{ padding: '14px 40px 0px 40px', flexDirection: 'row', gap: 20 }}>
        <Box style={{ width: 600, flexDirection: 'column', gap: 11 }}>
            <Box style={{ backgroundColor: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6, padding: '9px 16px' }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}><b>输入</b>　位姿 ＋ 三角化稀疏点 ＋ 单目深度（Depth Anything 3）</Text>
            </Box>
            <Box style={{ backgroundColor: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6, padding: '9px 16px' }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}><b>做法</b>　图像切 4×4 块，每块单独拟合 s、o 再插值上采样；层级按屏幕投影尺寸合并</Text>
            </Box>
            <Box style={{ backgroundColor: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6, padding: '9px 16px' }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}><b>输出</b>　每关键帧固定 30 次迭代的高斯优化；显存只留“看得见”的部分</Text>
            </Box>
            <Box style={{ backgroundColor: '#F0F5FC', border: '1px solid #3D7BD9', borderRadius: 6, padding: '10px 16px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}><b>关键取值</b>　depth_grid = 4　·　τ_l = 0.5 px　·　可并数 &#62; max(10%, 20 万)</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.4, marginTop: 4 }}>hierarchy_merge_ratio = 0.1、hierarchy_merge_min_count = 200000</Text>
            </Box>
        </Box>
        <Box style={{ width: 580, flexDirection: 'column' }}>
            <Image src="figs/fig7_gauss.png" style={{ width: 580, height: 362 }} />
            <Text style={{ fontSize: 14.5, color: '#8B97A8', marginTop: 5 }}>图 7　左：分块深度对齐；右：叶节点按屏幕尺寸合并成父节点。</Text>
        </Box>
    </Box>
    <Box style={{ margin: '12px 40px 0px 40px', backgroundColor: '#F7F9FC', borderLeft: '5px solid #1E4FA8', padding: '10px 18px', flexDirection: 'column' }}>
        <Image src="formula/f11.png" style={{ width: 408.5, height: 26.5 }} />
        <Text style={{ fontSize: 16.5, color: '#4A5568', lineHeight: 1.4, marginTop: 3 }}>消融 NoLoDepAlgn：26.29 → 25.41 dB。层级只压显存、不改位姿，所以能安全放在链路末端。</Text>
    </Box>
    <Box style={{ marginTop: 'auto', padding: '10px 40px 12px 40px' }}>
        <Text style={{ fontSize: 15, color: '#8B97A8' }}>7 步走完，一帧的贡献结束；下一个关键帧进来，从第 ① 步重新开始。</Text>
    </Box>
</Slide>
