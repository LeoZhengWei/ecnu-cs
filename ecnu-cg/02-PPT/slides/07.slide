<Slide style={{ width: '1280px', height: '720px', backgroundColor: '#FFFFFF', padding: '0px', flexDirection: 'column' }}>
    <Box style={{ width: '1280px', height: '8px', backgroundColor: '#1E4FA8' }} />
    <Box style={{ padding: '26px 40px 0px 40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8' }}>算法地图：七步重建链，用在哪、算什么、管什么</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8' }}>07 / 14</Text>
    </Box>
    <Box style={{ padding: '10px 40px 0px 40px' }}>
        <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.4 }}>位姿重建真正发生在 <b>第 5 步</b>：前三步只为它准备可信观测，第 4 步划定它的变量范围，第 6 步修它累积的漂移，第 7 步才轮到高斯。</Text>
    </Box>

    <Box style={{ padding: '12px 40px 0px 40px', flexDirection: 'row', gap: 10 }}>
        <Box style={{ flex: 1, height: 46, backgroundColor: '#F0F5FC', borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>① 检索</Text>
        </Box>
        <Box style={{ flex: 1, height: 46, backgroundColor: '#F0F5FC', borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>② 粗筛</Text>
        </Box>
        <Box style={{ flex: 1, height: 46, backgroundColor: '#F0F5FC', borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>③ 建边</Text>
        </Box>
        <Box style={{ flex: 1, height: 46, backgroundColor: '#F0F5FC', borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>④ 选窗</Text>
        </Box>
        <Box style={{ flex: 1, height: 46, backgroundColor: '#1E4FA8', borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>⑤ 局部 BA</Text>
        </Box>
        <Box style={{ flex: 1, height: 46, backgroundColor: '#F0F5FC', borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>⑥ 纠偏</Text>
        </Box>
        <Box style={{ flex: 1, height: 46, backgroundColor: '#F0F5FC', borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>⑦ 落位</Text>
        </Box>
    </Box>

    <Box style={{ padding: '12px 40px 0px 40px', flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', backgroundColor: '#1E4FA8', padding: '10px 14px' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>步</Text>
            <Text style={{ width: '258px', fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>算法</Text>
            <Text style={{ flex: 2.2, fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>核心公式 / 判据</Text>
            <Text style={{ flex: 2.4, fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>在重建中的作用</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', minHeight: 58, padding: '10px 14px', borderBottom: '1px solid #D6DCE5' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>①</Text>
            <Text style={{ width: '258px', fontSize: 18, color: '#1A2230' }}>MegaLoc 全局描述子</Text>
            <Text style={{ flex: 2.2, fontSize: 18, color: '#1A2230' }}>s = d_i · d_j，取 top-K = 20</Text>
            <Text style={{ flex: 2.4, fontSize: 18, color: '#1A2230' }}>从全部历史帧里找"可能同处"的候选，与帧序无关</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', minHeight: 58, padding: '10px 14px', backgroundColor: '#F7F9FC', borderBottom: '1px solid #D6DCE5' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>②</Text>
            <Text style={{ width: '258px', fontSize: 18, color: '#1A2230' }}>XFeat 局部特征穷举</Text>
            <Text style={{ flex: 2.2, fontSize: 18, color: '#1A2230' }}>K' = top-5 |M_ij|（按内点数）</Text>
            <Text style={{ flex: 2.4, fontSize: 18, color: '#1A2230' }}>淘汰"外观像、但没对上点"的候选</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', minHeight: 58, padding: '10px 14px', borderBottom: '1px solid #D6DCE5' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>③</Text>
            <Text style={{ width: '258px', fontSize: 18, color: '#1A2230' }}>LightGlue + RANSAC</Text>
            <Text style={{ flex: 2.2, fontSize: 18, color: '#1A2230' }}>|M_ij| &gt; τ_m = 500 才建边；w_ij = 1/|M_ij|</Text>
            <Text style={{ flex: 2.4, fontSize: 18, color: '#1A2230' }}>唯一产生共视约束的一步，结果写入协视图</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', minHeight: 58, padding: '10px 14px', backgroundColor: '#F7F9FC', borderBottom: '1px solid #D6DCE5' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>④</Text>
            <Text style={{ width: '258px', fontSize: 18, color: '#1A2230' }}>协视图贪心扩张（式 1）</Text>
            <Text style={{ flex: 2.2, fontSize: 18, color: '#1A2230' }}>S ← S ∪ argmax Σ_j |M_ij|，至 20 帧</Text>
            <Text style={{ flex: 2.4, fontSize: 18, color: '#1A2230' }}>划定 BA 的变量范围：最该一起优化的 20 帧</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', minHeight: 58, padding: '10px 14px', backgroundColor: '#E8F0FB', borderTop: '1px solid #3D7BD9', borderBottom: '1px solid #3D7BD9' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>⑤</Text>
            <Text style={{ width: '258px', fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>GPU 局部 BA（LM + Schur）</Text>
            <Text style={{ flex: 2.2, fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>min Σ ρ( ||u_ij − π(T_i, X_j)||² )</Text>
            <Text style={{ flex: 2.4, fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>真正解出位姿 T_i 与三维点 X_j——重建本体</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', minHeight: 58, padding: '10px 14px', borderBottom: '1px solid #D6DCE5' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>⑥</Text>
            <Text style={{ width: '258px', fontSize: 18, color: '#1A2230' }}>簇级回环 + 图传播</Text>
            <Text style={{ flex: 2.2, fontSize: 18, color: '#1A2230' }}>跳数 &gt; 5 触发；T_Δ = T_a^opt(T_a^init)^-1</Text>
            <Text style={{ flex: 2.4, fontSize: 18, color: '#1A2230' }}>两簇各扩 N/2 帧焊接，得 Sim(3) 后沿主干摊回</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', minHeight: 58, padding: '10px 14px', backgroundColor: '#F7F9FC' }}>
            <Text style={{ width: '44px', fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>⑦</Text>
            <Text style={{ width: '258px', fontSize: 18, color: '#1A2230' }}>分块深度对齐 + 渐进层级</Text>
            <Text style={{ flex: 2.2, fontSize: 18, color: '#1A2230' }}>size &lt; τ_l 且占比 &gt; 20% → KL 合并</Text>
            <Text style={{ flex: 2.4, fontSize: 18, color: '#1A2230' }}>位姿定后才投放高斯；层级只压显存，不改位姿</Text>
        </Box>
    </Box>

    <Box style={{ padding: '12px 40px 0px 40px' }}>
        <Text style={{ fontSize: 16, color: '#8B97A8', lineHeight: 1.45 }}>加粗行是位姿求解本身，第 ⑥ 步会对已求出的位姿再整体修正一次。符号：u 像素观测、π 投影、ρ 鲁棒核、T 相机位姿、X 路标点。</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', lineHeight: 1.45, marginTop: 3 }}>① 的 VPR 论文写 MixVPR，开源代码因许可原因换为 MegaLoc；τ_m = 500，τ_l = 0.5 px，N = 20，K = 20。</Text>
    </Box>
</Slide>
